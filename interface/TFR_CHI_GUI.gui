guitypes = {
	#疫情決議GUI
	containerwindowtype = {
		name = "CHI_vaccine_gui"
		size = { width = 100%% height = 100 }

		# 進度條容器
		containerwindowtype = {
			name = "progbar_container"
			position = { x = 20 y = 20 }

			# 進度條本體
			icontype = {
				name = "support_progbar_vaccine"
				quadtexturesprite = "GFX_PRCref_support_progress_red"
				position = { x = 8 y = 7 }
			}
			icontype = {
				name = "progbar_frame"
				spritetype = "GFX_PRCref_progress_frame"
				alwaystransparent = yes
			}

			# 百分比文字
			instantTextBoxType = {
				name = "support_reforms_text"
				text = "[?CHI:CHI_vaccine_progress]%"
				position = { x = 395 y = 10 }
				font = "VCR02_24"
				format = center
				maxwidth = 110
				maxheight = 30
				text_color_code = C
			}
		}

		# 標題
		instantTextBoxType = {
			name = "Title"
			position = { x = 30 y = -10 }
			text = CHI_vaccine_tt
			font = "VCR02_24"
			maxwidth = 500
			#maxheight = 36
			format = left
		}


		instantTextBoxType = {
			name = "description"
			position = { x = 0 y = 75 }
			text = CHI_vaccine_dece
			font = "VCR02_12"
			maxwidth = 482
			#maxheight = 36
			format = center
		}

		instantTextBoxType = {
			name = "vaccine"
